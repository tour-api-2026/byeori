# ─────────────────────────────────────────────────────────────
# 벼리 "앱(클라이언트)" 공개 환경변수 템플릿 — 실제 값은 apps/app/.env (커밋 금지)
# ⚠️ EXPO_PUBLIC_* 는 앱 번들에 그대로 박힌다(누구나 추출 가능 = 공개값).
#    서버 시크릿(JWT_SECRET 등)은 절대 여기 두지 말 것 → infra/.env 에.
# ─────────────────────────────────────────────────────────────

# 데이터 API 주소 (nginx → byeori-api)
EXPO_PUBLIC_API_URL=https://byeori.seoulride.site/api/v1

# 카카오 지도 JavaScript 키 (앱 키 → JavaScript 키). Web 플랫폼 사이트 도메인에 https://byeori.seoulride.site 등록
EXPO_PUBLIC_KAKAO_JS_KEY=

# 소셜 로그인 — 카카오 "네이티브 앱 키" (앱 키 → 네이티브 앱 키). 네이티브 SDK + APK에서만 동작
EXPO_PUBLIC_KAKAO_NATIVE_KEY=

# 소셜 로그인 — 구글 OAuth 클라이언트 ID (백엔드 GOOGLE_CLIENT_ID와 동일 값)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

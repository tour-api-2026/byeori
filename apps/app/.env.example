# 벼리 앱 환경변수 예시 — 실제 값은 .env 에 작성(커밋 금지)
# 카카오 지도 JavaScript 키 (developers.kakao.com → 앱 키 → JavaScript 키)
# Web 플랫폼 사이트 도메인에 https://byeori.seoulride.site 등록 필요 (WebView origin과 일치)
EXPO_PUBLIC_KAKAO_JS_KEY=여기에_JavaScript_키

# 데이터 API 주소 (미설정 시 dev에서 호스트 자동 추론)
# EXPO_PUBLIC_API_URL=https://your-api-host/api/v1

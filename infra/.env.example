# ─────────────────────────────────────────────────────────────
# 벼리 "백엔드" 시크릿 템플릿 — 실제 값은 infra/.env 에 작성(커밋 금지)
# docker compose의 byeori-api 서비스가 env_file로 컨테이너에 주입.
# ⚠️ 서버 전용. 앱 공개값(EXPO_PUBLIC_*)은 apps/app/.env 에 둔다.
# ─────────────────────────────────────────────────────────────

# 실데이터 동기화
TOURAPI_KEY=          # data.go.kr 15101578 "일반 인증키(Decoding)"
KOPIS_KEY=            # kopis.or.kr 서비스키

# 인증
JWT_SECRET=           # 32바이트 이상 랜덤(예: python -c "import secrets;print(secrets.token_urlsafe(48))")
GOOGLE_CLIENT_ID=     # 구글 id_token 검증용(앱의 EXPO_PUBLIC_GOOGLE_CLIENT_ID와 동일 값)
# 카카오는 네이티브 SDK 방식 → 백엔드 키 불필요
